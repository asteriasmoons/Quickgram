{
  "name": "quickgram",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "node -e \"const fs=require('node:fs'); for (const dir of ['dist','miniapp/dist']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "build": "npm run clean && npm run build:miniapp && tsc -p tsconfig.build.json",
    "build:miniapp": "npm --prefix miniapp run build",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --prefix miniapp run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.34.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
